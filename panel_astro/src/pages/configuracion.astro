---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Layout title="Configuracion | IC-Desk Enterprise">
  <div class="c-layout">
    <div id="space-background" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none;" transition:persist>
      <canvas id="starfield"></canvas>
    </div>
    
    <Sidebar />
    
    <main class="c-main" style="position: relative; z-index: 1;"><header class="c-main__header"><div><h1 class="c-page-header__title" style="margin: 0;">Configuración Global</h1><p class="c-page-header__desc" style="margin: 0;">Ajustes del servidor, retención de logs y parámetros generales.</p></div><button class="c-btn c-btn--primary" onclick="saveConfig()"><span>Guardar Cambios</span></button></header><div class="c-main__content"><div class="c-card" style="max-width: 800px; margin: 0 auto;"><div class="c-card__header"><h2 class="c-card__title">Parámetros del Sistema</h2></div><div class="c-card__body"><div id="config-form"><div style="color:var(--c-text-muted); font-size:13px; text-align:center;">Cargando configuración...</div></div></div></div></div></main>
  </div>

</Layout>
