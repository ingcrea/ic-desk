---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Dashboard | IC-Desk">
  <div class="c-layout">
  <div id="space-background" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;"><canvas id="starfield"></canvas></div>

  <Sidebar />
  <!-- WRAPPER DASHBOARD -->
  <main class="c-main">
<div id="dashboard-body" style="display: flex; flex: 1; overflow: hidden; width: 100%;">
  
  <!-- CONTENIDO PRINCIPAL -->
  <div id="main-content" style="width: 100%;" >
    <div class="section-title">
      Equipos de Clientes Monitoreados
    </div>
    <div id="agents-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-10 p-10 overflow-y-auto w-full max-w-[98%] mx-auto custom-scrollbar content-start pb-24">
      <!-- Renderizado Dinámico -->
    </div>
  </div>

</div>

<!-- LIVE SESSION VIEW -->
<div id="session-view">
  <div id="session-sidebar">
    <div id="session-info-header">
      <h2 id="session-title">Consola de Control</h2>
      <span class="agent-status" style="background: rgba(16, 185, 129, 0.15); color: var(--success); font-size: 11px; padding: 3px 8px; border-radius: 99px;">Transmisión Cifrada</span>
    </div>

    <!-- ACCIONES RÁPIDAS SIEMPRE VISIBLES -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; padding: 0 12px 10px;">
      <button class="tool-card-btn" style="background:rgba(59,130,246,0.15); border:1px solid rgba(59,130,246,0.3);" onclick="startStream()">🖥️ Ver Pantalla</button>
      <button class="tool-card-btn" style="background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3);" onclick="closeSession()">✕ Cerrar</button>
      <button class="tool-card-btn" onclick="requestElevation()">🛡️ Elevar Admin</button>
      <button class="tool-card-btn" onclick="toggleVideoMode()" id="video-mode-btn">🎥 JPEG</button>
      <button class="tool-card-btn" style="grid-column: span 2; text-align: center; background:rgba(255,255,255,0.08);" onclick="openConsoleModal()">>_ Terminal PowerShell</button>
      <button class="tool-card-btn" onclick="activeWs && activeWs.send(JSON.stringify({type:'get_clipboard'}))">📋 Portapapeles</button>
      <button class="tool-card-btn" onclick="sendClipboard()">📝 Pegar</button>
    </div>

    <!-- CATEGORÍAS DE HERRAMIENTAS TI -->
    <div id="ti-toolbox" style="overflow-y:auto; flex:1; padding: 0 8px 10px;">

      <!-- ══════════════ 1. INFORMACIÓN ══════════════ -->
      <div class="ti-category" data-cat="info">
        <button class="ti-cat-header" onclick="toggleCat('info')" style="--cat-color:#60a5fa;">
          <span>🔍 <strong>Información</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-info">
          <div class="ti-grid">
            <button class="ti-btn" onclick="runPS('Get-ComputerInfo | Select-Object -Property CsName,CsManufacturer,CsModel,OsName,OsVersion,BiosVersion,CsProcessors,CsTotalPhysicalMemory | Format-List')">📋 MSInfo</button>
            <button class="ti-btn" onclick="runTI('battery')">🔋 Batería</button>
            <button class="ti-btn" onclick="runTI('charger')">⚡ Amperaje</button>
            <button class="ti-btn" onclick="runPS('$missing = Get-PnpDevice | Where-Object {$_.Status -ne [string]&quot;OK&quot;}; if($missing) { $missing | Select-Object FriendlyName,Status | Format-Table -AutoSize } else { Write-Output &quot;Todos los drivers OK&quot; }')">🔌 Drivers</button>
            <button class="ti-btn" onclick="runPS('Get-WmiObject -Class Win32_BIOS | Select-Object Manufacturer,Name,Version,ReleaseDate,SMBIOSBIOSVersion | Format-List')">💾 BIOS</button>
            <button class="ti-btn" onclick="runTI('tempcpu')">🌡️ Temp CPU</button>
            <button class="ti-btn" onclick="runPS('Get-WmiObject Win32_ComputerSystem | Select-Object Name,Manufacturer,Model,TotalPhysicalMemory,NumberOfProcessors | Format-List')">🖥️ Hardware</button>
            <button class="ti-btn" onclick="runPS('Get-WmiObject Win32_DiskDrive | Select-Object Model,Size,Status,InterfaceType | Format-Table -AutoSize')">💿 Discos</button>
          </div>
        </div>
      </div>

      <!-- ══════════════ 2. RENDIMIENTO ══════════════ -->
      <div class="ti-category" data-cat="perf">
        <button class="ti-cat-header" onclick="toggleCat('perf')" style="--cat-color:#34d399;">
          <span>📊 <strong>Rendimiento</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-perf">
          <div class="ti-grid">
            <button class="ti-btn" onclick="runTI('cpu')">🧠 CPU %</button>
            <button class="ti-btn" onclick="runTI('ram')">🧩 RAM</button>
            <button class="ti-btn" onclick="runTI('drives')">💾 Discos</button>
            <button class="ti-btn" onclick="runPS('Get-NetAdapterStatistics | Select-Object Name,ReceivedBytes,SentBytes | Format-Table')">🌐 Red I/O</button>
            <button class="ti-btn" onclick="runTI('topproc')">🔝 Top Proc</button>
            <button class="ti-btn" onclick="runTI('ramsum')">📈 Resumen</button>
            <button class="ti-btn" onclick="runPS('Get-WmiObject Win32_VideoController | Select-Object Caption,AdapterRAM,DriverVersion,VideoModeDescription | Format-List')">🎮 GPU</button>
            <button class="ti-btn" onclick="runPS('Get-WmiObject Win32_Processor | Select-Object Name,MaxClockSpeed,CurrentClockSpeed,NumberOfCores,NumberOfLogicalProcessors,LoadPercentage | Format-List')">⚡ CPU Info</button>
          </div>
        </div>
      </div>

      <!-- ══════════════ 3. SOPORTE ══════════════ -->
      <div class="ti-category" data-cat="supp">
        <button class="ti-cat-header" onclick="toggleCat('supp')" style="--cat-color:#facc15;">
          <span>🔧 <strong>Soporte</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-supp">
          <div class="ti-grid">
            <button class="ti-btn" onclick="runPS('Get-Service | Sort-Object Status -Descending | Select-Object Name,DisplayName,Status | Format-Table -AutoSize')">⚙️ Servicios</button>
            <button class="ti-btn" onclick="runPS('Start-Process msconfig -Verb RunAs')">🔩 MSConfig</button>
            <button class="ti-btn" onclick="runPS('Start-Process taskmgr')">📋 Tareas</button>
            <button class="ti-btn" onclick="runPS('Start-Process regedit -Verb RunAs')">📝 Registro</button>
            <button class="ti-btn" onclick="runPS('Start-Process gpedit.msc -Verb RunAs')">🏛️ GPO</button>
            <button class="ti-btn" onclick="runPS('[System.Environment]::GetEnvironmentVariables() | Out-String')">🔣 Variables</button>
            <button class="ti-btn" onclick="runTI('apperrlog')">⚠️ Errores App</button>
            <button class="ti-btn" onclick="runTI('installedapps')">📦 Programas</button>
          </div>
        </div>
      </div>

      <!-- ══════════════ 4. REPARACIÓN ══════════════ -->
      <div class="ti-category" data-cat="repair">
        <button class="ti-cat-header" onclick="toggleCat('repair')" style="--cat-color:#fb923c;">
          <span>🩺 <strong>Reparación</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-repair">
          <div class="ti-grid">
            <button class="ti-btn" onclick="runPS('sfc /scannow')">🛡️ SFC Scan</button>
            <button class="ti-btn" onclick="runPS('DISM /Online /Cleanup-Image /RestoreHealth')">🔬 DISM</button>
            <button class="ti-btn" onclick="runPS('chkdsk C: /f /r /x')">💽 ChkDsk</button>
            <button class="ti-btn" onclick="runPS('bcdedit')">🚀 BCDEdit</button>
            <button class="ti-btn" onclick="runPS('reagentc /enable; reagentc /info')">🔄 WinRE</button>
            <button class="ti-btn" onclick="runPS('Get-WindowsUpdateLog')">📋 WU Log</button>
            <button class="ti-btn" onclick="runPS('Get-HotFix | Sort-Object InstalledOn -Descending | Select-Object -First 20 | Format-Table -AutoSize')">📦 Parches</button>
            <button class="ti-btn" onclick="runPS('DISM /Online /Cleanup-Image /ScanHealth')">🔍 DISM Scan</button>
          </div>
        </div>
      </div>

      <!-- ══════════════ 5. LIMPIEZA ══════════════ -->
      <div class="ti-category" data-cat="clean">
        <button class="ti-cat-header" onclick="toggleCat('clean')" style="--cat-color:#22d3ee;">
          <span>🧹 <strong>Limpieza</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-clean">
          <div class="ti-grid">
            <button class="ti-btn" onclick="runTI('tempdel')">🗑️ Temporales</button>
            <button class="ti-btn" onclick="runPS('Clear-RecycleBin -Force -EA SilentlyContinue')">♻️ Papelera</button>
            <button class="ti-btn" onclick="runTI('ramclean')">🧩 Limpiar RAM</button>
            <button class="ti-btn" onclick="runPS('ipconfig /flushdns')">🌐 Flush DNS</button>
            <button class="ti-btn" onclick="runTI('prefetch')">⚡ Prefetch</button>
            <button class="ti-btn" onclick="runTI('wucache')">📦 WU Cache</button>
            <button class="ti-btn" onclick="runTI('usertmp')">👤 Usr Temp</button>
            <button class="ti-btn" onclick="runPS('cleanmgr /sagerun:1')">🛠️ DiskClean</button>
          </div>
        </div>
      </div>

      <!-- ══════════════ 6. REDES ══════════════ -->
      <div class="ti-category" data-cat="net">
        <button class="ti-cat-header" onclick="toggleCat('net')" style="--cat-color:#a78bfa;">
          <span>🌐 <strong>Redes</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-net">
          <div class="ti-grid">
            <button class="ti-btn" onclick="runTI('netinfo')">📡 Info Red</button>
            <button class="ti-btn" onclick="runPS('Get-NetAdapter | Select-Object Name,Status,LinkSpeed,MacAddress | Format-Table')">🔌 Adaptadores</button>
            <button class="ti-btn" onclick="netConfigModal('dhcp')">🔄 → DHCP</button>
            <button class="ti-btn" onclick="netConfigModal('static')">📌 → IP Fija</button>
            <button class="ti-btn" onclick="dnsModal()">🌐 Config DNS</button>
            <button class="ti-btn" onclick="runPS('ipconfig /flushdns; netsh winsock reset')">🔁 Reset Stack</button>
            <button class="ti-btn" onclick="runPS('netstat -ano')">🔭 Conexiones</button>
            <button class="ti-btn" onclick="runTI('scanlan')">🔍 Escanear LAN</button>
          </div>
        </div>
      </div>

      <!-- ══════════════ 7. DESINFECCIÓN ══════════════ -->
      <div class="ti-category" data-cat="disinfect">
        <button class="ti-cat-header" onclick="toggleCat('disinfect')" style="--cat-color:#f87171;">
          <span>🦠 <strong>Desinfección</strong></span><span class="ti-arrow">▼</span>
        </button>
        <div class="ti-cat-body" id="cat-disinfect">
          <div class="ti-grid">
            <button class="ti-btn" onclick="vtScanModal()">🛡️ VirusTotal</button>
            <button class="ti-btn" onclick="runTI('autoruns')">🚀 Autoarranque</button>
            <button class="ti-btn" onclick="runTI('hiddenproc')">👻 Proc Ocultos</button>
            <button class="ti-btn" onclick="runPS('Get-Service | Where-Object {$_.Status -eq [string]&quot;Running&quot; -and $_.StartType -eq [string]&quot;Automatic&quot;} | Select-Object Name,DisplayName | Format-Table')">⚙️ Serv. Auto</button>
            <button class="ti-btn" onclick="runPS('Start-MpScan -ScanType QuickScan')">🔍 Scan Rápido</button>
            <button class="ti-btn" onclick="runPS('Start-MpScan -ScanType FullScan')">🔬 Scan Full</button>
            <button class="ti-btn" onclick="runPS('Get-MpThreat | Format-Table -AutoSize')">☣️ Amenazas</button>
            <button class="ti-btn" onclick="runPS('netsh advfirewall show allprofiles')">🔥 Firewall</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- MODAL: Consola PowerShell -->
  <div id="console-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9500; align-items:center; justify-content:center; backdrop-filter:blur(3px);">
    <div style="background:#080b12; border:1px solid rgba(255,255,255,0.1); border-radius:12px; width:800px; max-width:95vw; height:600px; max-height:90vh; display:flex; flex-direction:column; box-shadow:0 25px 60px rgba(0,0,0,0.8); overflow:hidden;">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#1e293b; border-bottom:1px solid rgba(255,255,255,0.05);">
        <h3 style="color:#f8fafc; margin:0; font-size:13px; font-family:monospace;">>_ PowerShell Remoto</h3>
        <button onclick="document.getElementById('console-modal').style.display='none'" style="background:transparent; border:none; color:#94a3b8; font-size:16px; cursor:pointer; padding:4px;">✕</button>
      </div>
      <div id="console-wrap" style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
        <div id="console-output" style="flex:1; padding:12px; font-mono; font-size:12px; color:#a5d6ff; overflow-y:auto; line-height:1.5;"></div>
        <div id="console-input-bar" style="display:flex; border-top:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.02);">
          <input type="text" id="console-input" placeholder="Escribe comando PowerShell y presiona Enter..." style="flex:1; background:transparent; border:none; color:white; font-family:monospace; font-size:12px; padding:12px; outline:none;" />
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: Configuración IP/DNS -->
  <div id="net-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:9000; align-items:center; justify-content:center;">
    <div style="background:#0f172a; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:28px; width:380px; box-shadow:0 25px 60px rgba(0,0,0,0.6);">
      <h3 style="color:#f8fafc; margin:0 0 20px; font-size:1rem;">⚙️ Configurar Red</h3>
      <div id="net-modal-body"></div>
      <div style="display:flex; gap:10px; margin-top:20px;">
        <button onclick="applyNetConfig()" style="flex:1; padding:10px; border-radius:8px; background:#3b82f6; color:white; border:none; cursor:pointer; font-weight:700;">✅ Aplicar</button>
        <button onclick="document.getElementById('net-modal').style.display='none'" style="flex:1; padding:10px; border-radius:8px; background:rgba(255,255,255,0.08); color:#94a3b8; border:1px solid rgba(255,255,255,0.1); cursor:pointer;">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- MODAL: DNS rápido -->
  <div id="dns-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:9000; align-items:center; justify-content:center;">
    <div style="background:#0f172a; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:28px; width:400px; box-shadow:0 25px 60px rgba(0,0,0,0.6);">
      <h3 style="color:#f8fafc; margin:0 0 6px; font-size:1rem;">🌐 Configurar DNS rápido</h3>
      <p style="color:#64748b; font-size:0.75rem; margin:0 0 18px;">Selecciona el DNS y el adaptador de red destino</p>
      <div id="dns-adapter-list" style="margin-bottom:16px;"></div>
      <p style="color:#94a3b8; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:10px;">DNS disponibles</p>
      <div style="display:flex; flex-direction:column; gap:8px;" id="dns-options-list">
        <!-- Se llena con JS -->
      </div>
      <div style="display:flex; gap:10px; margin-top:20px;">
        <button onclick="document.getElementById('dns-modal').style.display='none'" style="flex:1; padding:10px; border-radius:8px; background:rgba(255,255,255,0.08); color:#94a3b8; border:1px solid rgba(255,255,255,0.1); cursor:pointer;">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- MODAL: VirusTotal -->
  <div id="vt-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:9000; align-items:center; justify-content:center;">
    <div style="background:#0f172a; border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:28px; width:480px; max-height:80vh; overflow-y:auto; box-shadow:0 25px 60px rgba(0,0,0,0.6);">
      <h3 style="color:#f8fafc; margin:0 0 6px; font-size:1rem;">🛡️ Escáner VirusTotal</h3>
      <p style="color:#64748b; font-size:0.75rem; margin:0 0 16px;">Envía hashes MD5 de procesos/servicios a VirusTotal</p>
      <div id="vt-results" style="background:rgba(0,0,0,0.3); border-radius:8px; padding:12px; min-height:80px; font-family:monospace; font-size:11px; color:#94a3b8; margin-bottom:16px;">Haz clic en "Escanear Procesos" para iniciar...</div>
      <div style="display:flex; gap:10px;">
        <button onclick="runVTScan()" style="flex:1; padding:10px; border-radius:8px; background:#ef4444; color:white; border:none; cursor:pointer; font-weight:700;">🔍 Escanear Procesos</button>
        <button onclick="document.getElementById('vt-modal').style.display='none'" style="flex:1; padding:10px; border-radius:8px; background:rgba(255,255,255,0.08); color:#94a3b8; border:1px solid rgba(255,255,255,0.1); cursor:pointer;">Cerrar</button>
      </div>
    </div>
  </div>



  <div class="live-stream-area" id="live-stream-area">
    <div style="position: absolute; top: 10px; left: 10px; z-index: 50; display: flex; gap: 10px;">
      <button id="toggle-sidebar-btn" class="btn-action" style="background: rgba(17,24,39,0.7); backdrop-filter: blur(5px); font-size: 11px; padding: 6px 12px;" onclick="toggleSidebar()">
        <span id="sidebar-icon">◀ Ocultar Panel</span>
      </button>
    </div>
    <div style="position: absolute; top: 10px; right: 10px; z-index: 50;">
      <button id="fullscreen-btn" class="btn-action" style="background: rgba(17,24,39,0.7); backdrop-filter: blur(5px); font-size: 11px; padding: 6px 12px;" onclick="toggleFullScreen()">⛶ Pantalla Completa</button>
    </div>

    <!-- Flecha flotante (Pantalla Completa) -->
    <div id="fullscreen-floating-arrow" onclick="slideInSidebarFullscreen()" style="display: none; position: absolute; left: 0; top: 50%; transform: translateY(-50%); z-index: 1000; background: rgba(0, 102, 204, 0.8); color: white; padding: 20px 10px; border-radius: 0 10px 10px 0; cursor: pointer; font-size: 24px; box-shadow: 2px 0 10px rgba(0,0,0,0.5); transition: left 0.3s ease;">
      ▶
    </div>

    <div id="stream-status-overlay">
      <div class="spinner" id="stream-status-spinner"></div>
      <div id="stream-status-text">Iniciando conexión con la terminal remota...</div>
    </div>
    <canvas id="screen-canvas" tabindex="0"></canvas>
    <div id="remote-cursor"></div>
  </div>
</div>

  
<!-- Modal Alias -->
<div id="alias-modal" class="c-modal">
  <div class="c-modal__content">
    <h3 class="c-modal__title">Editar Alias del Equipo</h3>
    <input type="text" id="alias-input" class="c-modal__input" placeholder="Ej. PC-Direccion" onkeydown="if(event.key==='Enter') window.saveAlias()">
    <div class="c-modal__actions">
      <button class="c-btn c-btn--outline" onclick="window.closeAliasModal()">Cancelar</button>
      <button class="c-btn c-btn--primary" onclick="window.saveAlias()">Guardar</button>
    </div>
  </div>
</div>

</main>
<script is:inline>
  
  // Fondo Espacial Compuesto
  function initStarfield() {
    const canvas = document.getElementById("starfield");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    
    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    const numStaticStars = 160;
    const staticStars = [];
    const starColors = ["#ffffff", "#f0f4f8", "#e2e8f0", "#63b3ed", "#90cdf4", "#b794f4", "#fbd38d"];

    for (let i = 0; i < numStaticStars; i++) {
      staticStars.push({
        x: Math.random(),
        y: Math.random(),
        size: Math.random() * 1.6 + 0.5,
        color: starColors[Math.floor(Math.random() * starColors.length)],
        baseAlpha: Math.random() * 0.7 + 0.3,
        twinkleSpeed: Math.random() * 0.02 + 0.005,
        alphaOffset: Math.random() * Math.PI * 2
      });
    }

    const numTravelStars = 40;
    const travelStars = [];
    for (let i = 0; i < numTravelStars; i++) {
      travelStars.push({
        x: (Math.random() - 0.5),
        y: (Math.random() - 0.5),
        z: Math.random() * 1000 + 1,
        size: Math.random() * 1.5 + 0.8,
        color: "rgba(255, 255, 255, 0.95)"
      });
    }

    const comets = [];
    function spawnComet() {
      if (comets.length >= 6) return;
      const angle = (Math.random() * 15 + 25) * (Math.PI / 180);
      const speed = Math.random() * 8 + 6;
      comets.push({
        x: Math.random() * (canvas.width * 0.7),
        y: Math.random() * (canvas.height * 0.4) - 50,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        length: Math.random() * 200 + 120,
        alpha: 1,
        decay: Math.random() * 0.008 + 0.004,
        width: Math.random() * 2.5 + 1.5
      });
    }

    setInterval(spawnComet, 1600);
    let time = 0;

    function animate() {
      time += 0.05;
      const width = canvas.width;
      const height = canvas.height;

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < staticStars.length; i++) {
        const star = staticStars[i];
        const alpha = Math.max(0.1, Math.min(1, star.baseAlpha + Math.sin(time * star.twinkleSpeed * 10 + star.alphaOffset) * 0.25));
        ctx.fillStyle = star.color;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(star.x * width, star.y * height, star.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1.0;

      for (let i = 0; i < travelStars.length; i++) {
        const ts = travelStars[i];
        ts.z -= 2.0;
        if (ts.z <= 0) {
          ts.z = 1000;
          ts.x = (Math.random() - 0.5);
          ts.y = (Math.random() - 0.5);
        }

        const k = 500 / ts.z;
        const px = ts.x * k * width + width / 2;
        const py = ts.y * k * height + height / 2;
        const size = Math.min(ts.size * k * 0.8, 3.5);

        if (px >= 0 && px <= width && py >= 0 && py <= height) {
          ctx.fillStyle = ts.color;
          ctx.beginPath();
          ctx.arc(px, py, size, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      for (let i = comets.length - 1; i >= 0; i--) {
        const c = comets[i];
        c.x += c.vx;
        c.y += c.vy;
        c.alpha -= c.decay;

        if (c.alpha <= 0 || c.x > width + 100 || c.y > height + 100) {
          comets.splice(i, 1);
          continue;
        }

        const headX = c.x;
        const headY = c.y;
        const tailX = c.x - (c.vx / Math.hypot(c.vx, c.vy)) * c.length;
        const tailY = c.y - (c.vy / Math.hypot(c.vx, c.vy)) * c.length;

        const grad = ctx.createLinearGradient(headX, headY, tailX, tailY);
        grad.addColorStop(0, "rgba(255, 255, 255, " + c.alpha + ")");
        grad.addColorStop(0.2, "rgba(147, 197, 253, " + (c.alpha * 0.7) + ")");
        grad.addColorStop(1, "rgba(147, 197, 253, 0)");

        ctx.beginPath();
        ctx.moveTo(headX, headY);
        ctx.lineTo(tailX, tailY);
        ctx.strokeStyle = grad;
        ctx.lineWidth = c.width;
        ctx.lineCap = "round";
        ctx.stroke();
      }

      requestAnimationFrame(animate);
    }
    animate();
  }
