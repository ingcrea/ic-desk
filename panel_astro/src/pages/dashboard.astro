---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard | IC-Desk">
<style>
  
    #header {
      background: rgba(17, 24, 39, 0.85);
      border-bottom: 1px solid var(--border);
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(10px);
      flex-shrink: 0;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-logo {
      height: 48px;
      width: auto;
    }

    .header-badge {
      background: rgba(0, 102, 204, 0.15);
      border: 1px solid var(--accent);
      color: var(--text);
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 99px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* --- MAIN CONTENT LAYOUT --- */
    #main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 32px;
      overflow-y: auto;
    }

    .section-title {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 18px;
      background: var(--accent);
      border-radius: 2px;
    }

    #agents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 24px;
    }

    /* --- HARDWARE INFO EN TARJETAS --- */
    .agent-host { font-size: 15px; font-weight: 600; color: #e2e8f0; }
    .hw-device-type { display: inline-flex; align-items: center; gap: 5px; font-size: 11px;
      font-weight: 600; padding: 2px 8px; border-radius: 20px; background: rgba(99,179,237,0.12);
      color: #63b3ed; border: 1px solid rgba(99,179,237,0.25); margin-top: 2px; width: fit-content; }
    .hw-make-model { font-size: 12px; color: var(--text-muted); margin-top: 1px; }
    .hw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px; }
    .hw-block { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px; padding: 9px 12px; }
    .hw-label { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 4px; }
    .hw-value { font-size: 12px; color: #e2e8f0; font-weight: 500; line-height: 1.4; word-break: break-word; }
    .hw-value small { font-size: 10px; color: var(--text-muted); }
    .hw-disk-row { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
    .hw-disk-bar-wrap { flex: 1; height: 4px; background: rgba(255,255,255,0.08); border-radius: 99px; overflow: hidden; }
    .hw-disk-bar { height: 100%; border-radius: 99px;
      background: linear-gradient(90deg, #48bb78, #38a169); transition: width 0.5s ease; }
    .hw-disk-bar.warn { background: linear-gradient(90deg, #ed8936, #dd6b20); }
    .hw-disk-bar.crit { background: linear-gradient(90deg, #fc8181, #e53e3e); }
    .hw-ram-pills { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
    .hw-ram-pill { font-size: 10px; padding: 2px 6px; border-radius: 4px;
      background: rgba(159,122,234,0.15); color: #b794f4; border: 1px solid rgba(159,122,234,0.2); }

    /* --- ENTERPRISE AGENT CARD --- */
    .agent-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      backdrop-filter: blur(10px);
      display: flex;
      flex-direction: column;
      gap: 16px;
      transition: all 0.3s;
    }

    .agent-card:hover {
      border-color: var(--border-active);
      box-shadow: 0 10px 30px rgba(0, 102, 204, 0.1);
    }

    .agent-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .agent-id-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 700;
      color: #fff;
    }

    .pulse-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 12px var(--success);
      animation: pulse 1.8s infinite;
    }

    .agent-host {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: -10px;
    }

    .card-divider {
      height: 1px;
      background: var(--border);
    }

    .system-badge-row {
      display: flex;
      gap: 8px;
    }

    .sys-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
    }

    .card-actions {
      display: flex;
      gap: 10px;
      margin-top: 8px;
    }

    .btn-action {
      flex: 1;
      padding: 10px 16px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-action:hover {
      background: var(--border);
      border-color: #4b5563;
    }

    .btn-action.primary {
      background: var(--accent);
      border-color: transparent;
      box-shadow: 0 4px 15px var(--accent-glow);
    }

    .btn-action.primary:hover {
      background: var(--accent-hover);
      box-shadow: 0 6px 20px rgba(0, 102, 204, 0.5);
    }

    /* --- ACTIVE LIVE SESSION CONTROLLER (FULLSCREEN) --- */
    #session-view {
      display: none;
      position: fixed;
      inset: 0;
      background: #03050a;
      z-index: 500;
      flex-direction: row;
    }

    #session-view.active { display: flex; }

    #session-sidebar {
      width: 380px;
      background: rgba(17, 24, 39, 0.85);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      backdrop-filter: blur(20px);
      z-index: 600;
    }

    #session-info-header {
      padding: 24px;
      border-bottom: 1px solid var(--border);
    }

    #session-info-header h2 {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .live-stream-area {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      overflow: hidden;
    }

    #screen-canvas {
      width: 100%;
      height: 100%;
      object-fit: fill; /* Llenar completamente la ventana sin bordes negros */
      z-index: 10;
    }

    #stream-status-overlay {
      position: absolute;
      inset: 0;
      background: rgba(5, 8, 16, 0.9);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 20;
      transition: opacity 0.3s ease;
    }

    .spinner {
      width: 48px;
      height: 48px;
      border: 4px solid rgba(255, 255, 255, 0.1);
      border-left-color: var(--accent);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    #stream-status-text {
      font-size: 14px;
      color: var(--text-muted);
      text-align: center;
      max-width: 280px;
      line-height: 1.5;
    }

    /* --- TI DIAGNOSTIC TOOLBOX --- */
    .toolbox-section {
      padding: 20px 24px;
      border-bottom: 1px solid var(--border);
    }

    .toolbox-section h3 {
      font-size: 11px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }

    .grid-tools {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .tool-card-btn {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      padding: 10px;
      border-radius: 8px;
      color: var(--text);
      font-family: 'Outfit', sans-serif;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s;
    }

    .tool-card-btn:hover {
      background: rgba(0, 102, 204, 0.15);
      border-color: var(--accent);
    }

    /* Terminal Console */
    #console-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #080b12;
      overflow: hidden;
    }

    #console-output {
      flex: 1;
      padding: 20px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: #a5d6ff;
      overflow-y: auto;
      line-height: 1.6;
    }

    .con-log-sys { color: var(--text-muted); font-style: italic; }
    .con-log-cmd { color: #58a6ff; font-weight: bold; }
    .con-log-out { color: #7ee787; }
    .con-log-err { color: var(--danger); }

    #console-input-bar {
      display: flex;
      border-top: 1px solid var(--border);
      background: rgba(17, 24, 39, 0.9);
    }

    #console-input-bar input {
      flex: 1;
      background: transparent;
      border: none;
      color: #fff;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      padding: 16px;
      outline: none;
    }
  
    @media (max-width: 640px) {
      .login-card { width: 92% !important; padding: 24px 18px !important; border-radius: 18px !important; }
      .login-logo { max-height: 48px !important; }
      h2 { font-size: 22px !important; }
      footer { position: relative !important; bottom: auto !important; margin-top: 24px !important; padding-bottom: 20px !important; }
    }

  
  #header { display: flex !important; }
  #main-content { display: flex !important; }
  </style>
  <script is:inline>
  
  let monitoringInterval = null;
  let activeWs = null;
  let currentAgentId = null;
  const WS_RELAY_URL = window.location.protocol === 'https:' ? `wss://${window.location.host}` : `ws://${window.location.hostname}:6001`;

  let canvas = null;
  let ctx = null;

  window.addEventListener('DOMContentLoaded', async () => {
    canvas = document.getElementById('screen-canvas');
    if (canvas) ctx = canvas.getContext('2d');
    
    try {
      const res = await fetch('/soporte/agentes', { credentials: 'include' });
      if (!res.ok) {
        window.location.href = '/';
        return;
      }
      startMonitoring();
    } catch (e) {
      window.location.href = '/';
    }
  });


  </script>
</Layout>
