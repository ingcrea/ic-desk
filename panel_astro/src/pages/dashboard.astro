---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Dashboard | IC-Desk">
  <div class="c-layout">
  <div id="space-background" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;"><canvas id="starfield"></canvas></div>

  <Sidebar />
  <!-- WRAPPER DASHBOARD -->
  <main class="c-main">
<div id="dashboard-body" style="display: flex; flex: 1; overflow: hidden; width: 100%;">
  
  <!-- CONTENIDO PRINCIPAL -->
  <div id="main-content" style="width: 100%;" >
    <div class="section-title">
      Equipos de Clientes Monitoreados
    </div>
    <div id="agents-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-10 p-10 overflow-y-auto w-full max-w-[98%] mx-auto custom-scrollbar content-start pb-24">
      <!-- Renderizado Dinámico -->
    </div>
  </div>

</div>

<!-- LIVE SESSION VIEW -->
<div id="session-view">
  <div id="session-sidebar">
    <div id="session-info-header">
      <h2 id="session-title">Consola de Control</h2>
      <span class="agent-status" style="background: rgba(16, 185, 129, 0.15); color: var(--success); font-size: 11px; padding: 3px 8px; border-radius: 99px;">Transmisión Cifrada</span>
    </div>

    <!-- CAJA DE HERRAMIENTAS DE TI -->
    <div class="toolbox-section">
      <h3>🛠️ Caja de Herramientas de TI</h3>
      <div class="grid-tools">
        <button class="tool-card-btn" onclick="startStream()">🖥️ Ver Pantalla</button>
        <button class="tool-card-btn" onclick="requestElevation()">🛡️ Solicitar Admin</button>
        <button class="tool-card-btn" onclick="installService()">⚙️ Instalar Servicio</button>
        <button class="tool-card-btn" onclick="toggleVideoMode()" id="video-mode-btn">🎥 Modo: Nítido (JPEG)</button>
        <button class="tool-card-btn" onclick="activeWs.send(JSON.stringify({type:'get_clipboard'}))">📋 Leer Portapapeles</button>
        <button class="tool-card-btn" onclick="sendClipboard()">📝 Pegar Portapapeles</button>
        <button class="tool-card-btn" onclick="runDiagnosticCmd('Get-Process')">📊 Ver Procesos</button>
        <button class="tool-card-btn" onclick="runDiagnosticCmd('Get-Service')">⚙️ Ver Servicios</button>
        <button class="tool-card-btn" onclick="runDiagnosticCmd('Clear-RecycleBin -Force')">🧹 Limpiar Temp</button>
        <button class="tool-card-btn" onclick="runDiagnosticCmd('irm https://desk.ingcrea.com | iex')">🔄 Forzar Actualización</button>
        <button class="tool-card-btn" onclick="closeSession()">✕ Cerrar Sesión</button>
      </div>
    </div>

    <!-- CONSOLA POWERSHELL -->
    <div id="console-wrap">
      <div id="console-output"></div>
      <div id="console-input-bar">
        <input type="text" id="console-input" placeholder="Escribe comando PowerShell y presiona Enter..." />
      </div>
    </div>
  </div>

  <div class="live-stream-area" id="live-stream-area">
    <div style="position: absolute; top: 10px; left: 10px; z-index: 50; display: flex; gap: 10px;">
      <button id="toggle-sidebar-btn" class="btn-action" style="background: rgba(17,24,39,0.7); backdrop-filter: blur(5px); font-size: 11px; padding: 6px 12px;" onclick="toggleSidebar()">
        <span id="sidebar-icon">◀ Ocultar Panel</span>
      </button>
    </div>
    <div style="position: absolute; top: 10px; right: 10px; z-index: 50;">
      <button id="fullscreen-btn" class="btn-action" style="background: rgba(17,24,39,0.7); backdrop-filter: blur(5px); font-size: 11px; padding: 6px 12px;" onclick="toggleFullScreen()">⛶ Pantalla Completa</button>
    </div>

    <!-- Flecha flotante (Pantalla Completa) -->
    <div id="fullscreen-floating-arrow" onclick="slideInSidebarFullscreen()" style="display: none; position: absolute; left: 0; top: 50%; transform: translateY(-50%); z-index: 1000; background: rgba(0, 102, 204, 0.8); color: white; padding: 20px 10px; border-radius: 0 10px 10px 0; cursor: pointer; font-size: 24px; box-shadow: 2px 0 10px rgba(0,0,0,0.5); transition: left 0.3s ease;">
      ▶
    </div>

    <div id="stream-status-overlay">
      <div class="spinner" id="stream-status-spinner"></div>
      <div id="stream-status-text">Iniciando conexión con la terminal remota...</div>
    </div>
    <canvas id="screen-canvas" tabindex="0"></canvas>
    <div id="remote-cursor"></div>
  </div>
</div>

  
<!-- Modal Alias -->
<div id="alias-modal" class="c-modal">
  <div class="c-modal__content">
    <h3 class="c-modal__title">Editar Alias del Equipo</h3>
    <input type="text" id="alias-input" class="c-modal__input" placeholder="Ej. PC-Direccion" onkeydown="if(event.key==='Enter') window.saveAlias()">
    <div class="c-modal__actions">
      <button class="c-btn c-btn--outline" onclick="window.closeAliasModal()">Cancelar</button>
      <button class="c-btn c-btn--primary" onclick="window.saveAlias()">Guardar</button>
    </div>
  </div>
</div>

</main>
<script is:inline>
  
  // Fondo Espacial Compuesto
  function initStarfield() {
    const canvas = document.getElementById("starfield");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    
    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    const numStaticStars = 160;
    const staticStars = [];
    const starColors = ["#ffffff", "#f0f4f8", "#e2e8f0", "#63b3ed", "#90cdf4", "#b794f4", "#fbd38d"];

    for (let i = 0; i < numStaticStars; i++) {
      staticStars.push({
        x: Math.random(),
        y: Math.random(),
        size: Math.random() * 1.6 + 0.5,
        color: starColors[Math.floor(Math.random() * starColors.length)],
        baseAlpha: Math.random() * 0.7 + 0.3,
        twinkleSpeed: Math.random() * 0.02 + 0.005,
        alphaOffset: Math.random() * Math.PI * 2
      });
    }

    const numTravelStars = 40;
    const travelStars = [];
    for (let i = 0; i < numTravelStars; i++) {
      travelStars.push({
        x: (Math.random() - 0.5),
        y: (Math.random() - 0.5),
        z: Math.random() * 1000 + 1,
        size: Math.random() * 1.5 + 0.8,
        color: "rgba(255, 255, 255, 0.95)"
      });
    }

    const comets = [];
    function spawnComet() {
      if (comets.length >= 6) return;
      const angle = (Math.random() * 15 + 25) * (Math.PI / 180);
      const speed = Math.random() * 8 + 6;
      comets.push({
        x: Math.random() * (canvas.width * 0.7),
        y: Math.random() * (canvas.height * 0.4) - 50,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        length: Math.random() * 200 + 120,
        alpha: 1,
        decay: Math.random() * 0.008 + 0.004,
        width: Math.random() * 2.5 + 1.5
      });
    }

    setInterval(spawnComet, 1600);
    let time = 0;

    function animate() {
      time += 0.05;
      const width = canvas.width;
      const height = canvas.height;

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < staticStars.length; i++) {
        const star = staticStars[i];
        const alpha = Math.max(0.1, Math.min(1, star.baseAlpha + Math.sin(time * star.twinkleSpeed * 10 + star.alphaOffset) * 0.25));
        ctx.fillStyle = star.color;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(star.x * width, star.y * height, star.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1.0;

      for (let i = 0; i < travelStars.length; i++) {
        const ts = travelStars[i];
        ts.z -= 2.0;
        if (ts.z <= 0) {
          ts.z = 1000;
          ts.x = (Math.random() - 0.5);
          ts.y = (Math.random() - 0.5);
        }

        const k = 500 / ts.z;
        const px = ts.x * k * width + width / 2;
        const py = ts.y * k * height + height / 2;
        const size = Math.min(ts.size * k * 0.8, 3.5);

        if (px >= 0 && px <= width && py >= 0 && py <= height) {
          ctx.fillStyle = ts.color;
          ctx.beginPath();
          ctx.arc(px, py, size, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      for (let i = comets.length - 1; i >= 0; i--) {
        const c = comets[i];
        c.x += c.vx;
        c.y += c.vy;
        c.alpha -= c.decay;

        if (c.alpha <= 0 || c.x > width + 100 || c.y > height + 100) {
          comets.splice(i, 1);
          continue;
        }

        const headX = c.x;
        const headY = c.y;
        const tailX = c.x - (c.vx / Math.hypot(c.vx, c.vy)) * c.length;
        const tailY = c.y - (c.vy / Math.hypot(c.vx, c.vy)) * c.length;

        const grad = ctx.createLinearGradient(headX, headY, tailX, tailY);
        grad.addColorStop(0, "rgba(255, 255, 255, " + c.alpha + ")");
        grad.addColorStop(0.2, "rgba(147, 197, 253, " + (c.alpha * 0.7) + ")");
        grad.addColorStop(1, "rgba(147, 197, 253, 0)");

        ctx.beginPath();
        ctx.moveTo(headX, headY);
        ctx.lineTo(tailX, tailY);
        ctx.strokeStyle = grad;
        ctx.lineWidth = c.width;
        ctx.lineCap = "round";
        ctx.stroke();
      }

      requestAnimationFrame(animate);
    }
    animate();
  }
  if (document.readyState === 'complete' || document.readyState === 'interactive') { initStarfield(); } else { window.addEventListener('DOMContentLoaded', initStarfield); }

  var monitoringInterval = null;
  let activeWs = null;
  let currentAgentId = null;
  const WS_RELAY_URL = window.location.protocol === 'https:' ? `wss://${window.location.host}` : `ws://${window.location.hostname}:6001`;

  const canvas = document.getElementById('screen-canvas');
  let ctx = null;
  if (canvas) ctx = canvas.getContext('2d');

  document.addEventListener('astro:page-load', async () => {
    try {
      const res = await fetch('/soporte/agentes', { credentials: 'include' });
      if (res.status === 401 || !res.ok) {
        window.location.href = '/';
        return;
      }
      startMonitoring();
    } catch (e) {
      window.location.href = '/';
    }
  });


  async function fetchAgents() {
    
    try {
      const res = await fetch('/soporte/agentes?t=' + Date.now(), { credentials: 'include' });
      if (res.status === 401) {
        window.location.href = '/';
        return;
      }
      const agents = await res.json();
      renderGrid(agents);
    } catch {}
  }

  function renderGrid(agents) {
    const grid = document.getElementById('agents-grid');
    if (Object.keys(agents).length === 0) {
      grid.innerHTML = '<div style="color:var(--text-muted); font-size:13px;">Buscando agentes activos en la red de soporte...</div>';
      return;
    }
    if (grid.innerHTML.includes('Buscando agentes activos')) {
      grid.innerHTML = '';
    }

    const activeIds = Object.keys(agents).filter(id => agents[id].online);
    Array.from(grid.children).forEach(child => {
        if (child.id && child.id.startsWith('agent-card-')) {
            const id = child.id.replace('agent-card-', '');
            if (!activeIds.includes(id)) {
                grid.removeChild(child);
            }
        }
    });

    for (const [id, info] of Object.entries(agents)) {
      if (!info.online) continue; // Solo mostrar los agentes en línea
      
      const hw = info.health || {};
      let savedAlias = localStorage.getItem('alias_' + id) || id;

      const isAdmin = info.isAdmin ? '<span class="px-1.5 py-0.5 rounded border border-emerald-500/30 text-emerald-400 bg-emerald-500/10 text-[9px] font-semibold tracking-widest uppercase ml-2">Admin</span>' : '';
      const diskTotal = (hw.disks && hw.disks[0]) ? hw.disks[0].total : 0;
      const diskUsed = (hw.disks && hw.disks[0]) ? hw.disks[0].used : 0;
      const diskFree = diskTotal - diskUsed;
      const diskPct = diskTotal > 0 ? Math.min(100, Math.round((diskUsed / diskTotal) * 100)) : 0;
      
      const ramPct = (hw.ramGB && hw.ramGB > 0 && hw.ramFreeGB) ? Math.round(((hw.ramGB - hw.ramFreeGB) / hw.ramGB) * 100) : 0;
      
      let winBadge = '';
      if (hw.winActivation) {
        let isLic = hw.winActivation.includes('Activado (Original)') || hw.winActivation.includes('Licenciado');
        let color = isLic ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-red-500/10 text-red-400 border-red-500/20';
        let text = isLic ? 'Win Activado' : 'Win NO Activado';
        winBadge = '<span class="rounded ' + color + ' text-[9px] font-black tracking-widest uppercase border border-dashed" style="padding: 3px 8px;">' + text + '</span>';
      }
      
      let ipBadge = hw.ipPrivada ? '<span class="rounded bg-gray-500/10 text-gray-300 text-[9px] font-black tracking-widest border border-gray-500/20" style="padding: 3px 8px;">' + hw.ipPrivada + '</span>' : '';
      
      let diskHtml = '<span class="text-[13px] text-gray-500 font-medium">Sin Datos</span>';
      if (diskTotal > 0) {
        let dColor = diskPct > 85 ? 'bg-red-500' : (diskPct > 70 ? 'bg-amber-500' : 'bg-emerald-500');
        let tColor = diskPct > 85 ? 'text-red-400' : (diskPct > 70 ? 'text-amber-400' : 'text-emerald-400');
        diskHtml = `
          <div class="flex-1 min-w-0 flex flex-col justify-center gap-1.5" style="padding-right: 0.5rem;">
            <div class="flex justify-between items-center text-[13px] font-medium">
              <span class="text-gray-300 truncate"><strong class="text-white">${diskTotal} GB</strong> (${diskFree.toFixed(1)} GB libres)</span>
              <span class="font-bold ${tColor}">${diskPct}%</span>
            </div>
            <div class="w-full bg-white/10 h-1.5 rounded-full overflow-hidden">
              <div class="h-full ${dColor}" style="width: ${diskPct}%"></div>
            </div>
          </div>
        `;
      }
      
      let officeHtml = '';
      if (hw.officeVersion) {
        let isOffLic = hw.officeActivation && (hw.officeActivation.includes('Licenciado') || hw.officeActivation.includes('Activado') || hw.officeActivation.includes('Suscripci'));
        let oColor = isOffLic ? 'text-emerald-400' : 'text-red-400';
        let oText = hw.officeActivation || 'Estado desconocido';
        oText = oText.replace(/Suscripci.n/g, 'Suscripción');
        if (isOffLic && !oText.includes('Activado')) oText = 'Activado ' + oText;
        officeHtml = `
          <div class="flex items-center gap-3 mt-1">
            <div class="w-8 h-8 rounded-full bg-orange-500/10 flex items-center justify-center flex-shrink-0 border border-orange-500/20">
              <svg class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-[12px] text-white font-bold leading-tight truncate">${hw.officeVersion}</div>
              <div class="text-[11px] ${oColor} font-medium truncate">${oText}</div>
            </div>
          </div>
        `;
      }

      const dataHash = JSON.stringify(hw) + savedAlias + isAdmin;
      let card = document.getElementById('agent-card-' + id);
      let isNew = false;
      if (!card) {
        card = document.createElement('div');
        card.id = 'agent-card-' + id;
        card.className = 'group relative bg-[#0B0D14] border border-white/10 rounded-2xl flex flex-col h-full min-h-[400px] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_60px_-15px_rgba(59,130,246,0.3)] hover:border-blue-500/30 overflow-hidden';
        isNew = true;
      }
      
      if (!isNew && card.dataset.hash === dataHash) continue;
      card.dataset.hash = dataHash;
      
      card.innerHTML = `
        <!-- Capa de Bruma (Mist Background Light) -->
        <div class="absolute inset-0 pointer-events-none">
          <div class="absolute -top-32 -right-32 w-80 h-80 bg-blue-500/10 rounded-full blur-[100px] opacity-70 group-hover:opacity-100 transition-opacity duration-700"></div>
          <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-purple-500/10 rounded-full blur-[100px] opacity-70 group-hover:opacity-100 transition-opacity duration-700"></div>
        </div>

        <!-- Body de la Tarjeta -->
        <div class="flex-1 flex flex-col relative z-10" style="padding: 1.25rem;">
          
          <!-- Título y Subtítulo con Badges Separados -->
          <div style="margin-bottom: 1.25rem;">
            <div class="flex flex-wrap items-center" style="gap: 6px; margin-bottom: 12px;">
              <span class="rounded bg-blue-500/10 text-blue-400 text-[9px] font-black tracking-widest uppercase border border-blue-500/20" style="padding: 3px 8px;" title="${hw.osCaption || 'Windows'}">${(hw.osCaption || 'Windows').replace('Microsoft ', '')}</span>
              <span class="rounded bg-purple-500/10 text-purple-400 text-[9px] font-black tracking-widest uppercase border border-purple-500/20" style="padding: 3px 8px;">WSS</span>
              ${isAdmin ? '<span class="rounded bg-emerald-500/10 text-emerald-400 text-[9px] font-black tracking-widest uppercase border border-emerald-500/20" style="padding: 3px 8px;">Admin</span>' : ''}
              ${winBadge}
              ${ipBadge}
            </div>

            <div class="flex justify-between items-start">
              <h3 class="text-3xl leading-none font-bold text-white tracking-tight truncate pr-4" style="padding-right: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%;">
       <span title="${id}">${savedAlias}</span>
       <button class="c-btn c-btn--icon" style="background:transparent; border:none; padding:0; width:auto; height:auto; font-size:12px; opacity:0.5; margin-left: 10px;" onclick="event.stopPropagation(); window.setAlias('${id}', '${savedAlias}')" title="Asignar Alias">✏️</button>
     </h3>
              <div class="relative flex items-center justify-center flex-shrink-0" style="margin-top: 6px; margin-right: 8px;">
                <div class="absolute inset-0 bg-emerald-400 rounded-full animate-ping opacity-75"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,1)]"></div>
              </div>
            </div>
            <div class="text-sm text-gray-400 flex items-center" style="gap: 8px; margin-top: 8px;">
              <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <span class="truncate font-medium">${info.hostname || 'Host desconocido'}</span>
            </div>
          </div>

          <!-- Lista Limpia de Iconos -->
          <div class="flex flex-col gap-4 mt-auto border-t border-white/5" style="padding-top: 1.25rem;">
            <!-- CPU -->
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-indigo-500/10 flex items-center justify-center flex-shrink-0 border border-indigo-500/20">
                <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div class="flex-1 min-w-0 flex flex-col justify-center gap-1.5" style="padding-right: 0.5rem;">
                <div class="flex justify-between items-center text-[13px] font-medium">
                  <span class="text-gray-300 truncate" title="${hw.cpu}">${hw.cpu || 'Procesador desconocido'}</span>
                  <span class="font-bold ${hw.cpuPct > 80 ? 'text-red-400' : (hw.cpuPct > 60 ? 'text-amber-400' : 'text-indigo-400')}">${hw.cpuPct || 0}%</span>
                </div>
                <div class="w-full bg-white/10 h-1.5 rounded-full overflow-hidden">
                  <div class="h-full ${hw.cpuPct > 80 ? 'bg-red-500' : (hw.cpuPct > 60 ? 'bg-amber-500' : 'bg-indigo-500')} transition-all duration-500" style="width: ${hw.cpuPct || 0}%"></div>
                </div>
              </div>
            </div>
            
            <!-- RAM -->
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-purple-500/10 flex items-center justify-center flex-shrink-0 border border-purple-500/20">
                <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
              </div>
              <div class="flex-1 min-w-0 flex flex-col justify-center gap-1.5" style="padding-right: 0.5rem;">
                <div class="flex justify-between items-center text-[13px] font-medium">
                  <span class="text-gray-300 truncate"><strong class="text-white">${hw.ramGB ? hw.ramGB : 0} GB</strong> ${hw.ramFreeGB ? '(' + hw.ramFreeGB.toFixed(1) + ' GB libres)' : ''}</span>
                  <span class="font-bold text-purple-400">${ramPct}%</span>
                </div>
                <div class="w-full bg-white/10 h-1.5 rounded-full overflow-hidden">
                  <div class="h-full bg-purple-500" style="width: ${ramPct}%"></div>
                </div>
              </div>
            </div>
            
            <!-- Disco -->
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center flex-shrink-0 border border-emerald-500/20">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
              </div>
              ${diskHtml}
            </div>

            <!-- Software / Office (Opcional) -->
            ${officeHtml}
          </div>
        </div>

        <!-- Footer Separado (Botón de Conectar Mejorado) -->
        <div class="bg-white/[0.02] border-t border-white/10 relative z-10 flex items-center justify-between gap-4 mt-auto" style="padding: 1rem 1.25rem;">
          <div class="flex flex-col">
            <span class="text-[10px] text-gray-400 uppercase tracking-widest font-black">Estado</span>
            <span class="text-[13px] font-bold text-emerald-400 flex items-center gap-1.5">
              En Línea
            </span>
          </div>
          <button class="relative group/btn flex items-center justify-center gap-2 p-3 rounded-lg bg-blue-600 hover:bg-blue-500 border border-blue-400/50 hover:border-blue-300 transition-all duration-300 active:scale-95 shadow-[0_0_15px_rgba(37,99,235,0.4)] hover:shadow-[0_0_25px_rgba(37,99,235,0.6)]" onclick="takeControl('${id}')">
            <span class="text-[13px] font-black text-white uppercase tracking-wider">Conectar</span>
            <svg class="w-4 h-4 text-white group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </div>
      `;
      if (isNew) grid.appendChild(card);
    }
  }

  function takeControl(id) {
    currentAgentId = id;
    document.getElementById('session-title').textContent = `Consola: ${id}`;
    document.getElementById('session-view').classList.add('active');
    
    // Configurar overlay en estado inicial de carga
    const overlay = document.getElementById('stream-status-overlay');
    const statusText = document.getElementById('stream-status-text');
    const spinner = document.getElementById('stream-status-spinner');
    
    overlay.style.display = 'flex';
    overlay.style.opacity = '1';
    overlay.classList.add('visible');
    spinner.style.display = 'block';
    statusText.innerHTML = `Estableciendo enlace de datos con terminal <b>${id}</b>...`;

    const wsUrl = `${WS_RELAY_URL}?type=panel&id=${id}&panel_key=${encodeURIComponent('SrC0mS0p0rt3#S3cur1tyKey#2026')}`;
    activeWs = new WebSocket(wsUrl);

    activeWs.onopen = () => {
      console.log(`[CHECKPOINT 1] WebSocket Panel ONOPEN disparado. WSS URL: ${wsUrl}`);
      statusText.innerHTML = `Conexión establecida. Solicitando flujo de video...`;
      startStream();
    };

    activeWs.onclose = (event) => {
      console.log(`[CHECKPOINT 2] WebSocket Panel ONCLOSE disparado. Code: ${event.code}, Reason: ${event.reason}`);
      spinner.style.display = 'none';
      overlay.style.display = 'flex';
      overlay.style.opacity = '1';
      statusText.innerHTML = `🔴 <b>Conexión cerrada.</b> Código: ${event.code}. El agente cerró la transmisión o se encuentra fuera de línea.`;
    };

    activeWs.onerror = (err) => {
      console.error(`[CHECKPOINT 3] WebSocket Panel ONERROR disparado. Error:`, err);
      spinner.style.display = 'none';
      overlay.style.display = 'flex';
      overlay.style.opacity = '1';
      statusText.innerHTML = `❌ <b>Error de comunicación:</b> Falló el enlace de transporte del WebSocket. Verifica el firewall del servidor.`;
    };

    activeWs.binaryType = 'arraybuffer';

    const processBinaryFrame = (buffer) => {
      // Ocultar overlay al recibir el primer frame exitoso
      if (overlay.style.display !== 'none') {
        overlay.style.opacity = '0';
        overlay.classList.remove('visible');
        setTimeout(() => { overlay.style.display = 'none'; }, 300);
      }

      const dataView = new DataView(buffer);
      if (dataView.getUint8(0) === 0x49 && dataView.getUint8(1) === 0x43) { // Magic "IC"
        // Verificar si es H264 ("ICH264") o Legacy JPEG
        const isH264 = dataView.getUint8(2) === 0x48 && dataView.getUint8(3) === 0x32 && dataView.getUint8(4) === 0x36 && dataView.getUint8(5) === 0x34;
        
        const w = dataView.getUint16(6);
        const h = dataView.getUint16(8);
        const x = dataView.getUint16(10);
        const y = dataView.getUint16(12);
        const sw = dataView.getUint16(14);
        const sh = dataView.getUint16(16);
        
        if (canvas.width !== sw || canvas.height !== sh) {
          canvas.width = sw;
          canvas.height = sh;
        }

        if (isH264) {
          // Inicializar VideoDecoder si no existe
          if (!window.h264Decoder) {
            window.h264Decoder = new VideoDecoder({
              output: (frame) => {
                ctx.drawImage(frame, 0, 0, canvas.width, canvas.height);
                frame.close();
              },
              error: (e) => console.error("[WebCodecs] Error en decodificador H264:", e)
            });
            window.h264Decoder.configure({
              codec: 'avc1.42E01E', // Baseline profile (compatible genérico)
              optimizeForLatency: true
            });
          }
          
          const videoData = new Uint8Array(buffer, 18);
          // Determinar si es keyframe (SPS NALU tipo 7 o IDR NALU tipo 5)
          // El NALU type está en los 5 bits inferiores del primer byte después del start code (00 00 00 01)
          let isKeyframe = false;
          if (videoData.length > 4 && videoData[0] === 0 && videoData[1] === 0 && videoData[2] === 0 && videoData[3] === 1) {
             const naluType = videoData[4] & 0x1F;
             if (naluType === 7 || naluType === 5) {
                 isKeyframe = true;
             }
          }
          
          try {
            const chunk = new EncodedVideoChunk({
              type: isKeyframe ? 'key' : 'delta',
              timestamp: performance.now() * 1000,
              data: videoData
            });
            window.h264Decoder.decode(chunk);
          } catch (e) {
            console.error("[WebCodecs] Chunk H.264 inválido:", e);
          }
        } else {
          // Extraer la porción JPEG legacy (a partir del byte 18)
          const jpegData = new Uint8Array(buffer, 18);
          const blob = new Blob([jpegData], { type: 'image/jpeg' });
          const url = URL.createObjectURL(blob);

          const img = new Image();
          img.onload = () => {
            ctx.drawImage(img, x, y, w, h);
            URL.revokeObjectURL(url); // Liberar memoria
          };
          img.src = url;
        }
      }
    };

    activeWs.onmessage = async (e) => {
      // 1. Recepción de fotogramas (Dirty Rectangles) en formato Binario
      if (e.data instanceof Blob) {
        const buffer = await e.data.arrayBuffer();
        processBinaryFrame(buffer);
        return;
      } else if (e.data instanceof ArrayBuffer) {
        processBinaryFrame(e.data);
        return;
      }

      // 2. Fallback para recepción de comandos JSON (Portapapeles, Diagnósticos, etc)
      if (typeof e.data !== 'string') return; // Seguridad extra
      
      let msg;
      try { 
        msg = JSON.parse(e.data); 
      } catch (err) { 
        console.error(`[CHECKPOINT ERROR] Error parseando JSON del WS:`, err);
        return; 
      }
      
      if (msg.type === 'frame') {
        // Soporte heredado para JSON Base64 (fallback)
        if (overlay.style.display !== 'none') {
          overlay.style.opacity = '0';
          overlay.classList.remove('visible');
          setTimeout(() => { overlay.style.display = 'none'; }, 300);
        }
        const img = new Image();
        img.onload = () => {
          if (canvas.width !== msg.sw || canvas.height !== msg.sh) {
            canvas.width = msg.sw;
            canvas.height = msg.sh;
          }
          ctx.drawImage(img, msg.x, msg.y, msg.cellW, msg.cellH);
        };
        img.src = 'data:image/jpeg;base64,' + msg.data;
      } else if (msg.type === 'agent_offline') {
        spinner.style.display = 'none';
        statusText.innerHTML = `⚠️ <b>El agente se encuentra offline en el Relay.</b> Intentando despertarlo mediante REST API...`;
        // Si el agente está offline, enviarle la orden de iniciar transmisión
        console.log("El agente está offline en el relay. Despertándolo...");
        fetch('/soporte/cmd', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + localStorage.getItem('icdesk_jwt')
          },
          body: JSON.stringify({ id: id, cmd: '__RELAY_START__' })
        }).catch(() => {});
      } else if (msg.type === 'agent_disconnected') {
        spinner.style.display = 'none';
        overlay.style.display = 'flex';
        overlay.style.opacity = '1';
        statusText.innerHTML = `⚠️ <b>El agente remoto se ha desconectado.</b> En espera de que vuelva a conectarse...`;
      }
    };

    // Enviar primer intento de despertar al agente de forma asíncrona
    setTimeout(() => {
      fetch('/soporte/cmd', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + localStorage.getItem('icdesk_jwt')
        },
        body: JSON.stringify({ id: id, cmd: '__RELAY_START__' })
      }).catch(() => {});
    }, 100);
  }

  function startStream() {
    if (activeWs) {
      if (activeWs.readyState === WebSocket.OPEN) {
        activeWs.send(JSON.stringify({ type: 'start_stream' }));
      } else if (activeWs.readyState === WebSocket.CONNECTING) {
        activeWs.addEventListener('open', () => {
          activeWs.send(JSON.stringify({ type: 'start_stream' }));
        });
      }
    }
  }

  
  function installService() {
    if (!activeWs) return;
    const cmd = "$exe = [System.Diagnostics.Process]::GetCurrentProcess().MainModule.FileName; Start-Process -FilePath $exe -ArgumentList '--install-service' -Verb RunAs";
    activeWs.send(JSON.stringify({ type: 'shell', command: cmd }));
    showToast('Solicitud de instalación como Servicio enviada...', 'info');
  }

  function requestElevation() {
    const uacCmd = `Start-Process powershell -Verb runas`;
    runDiagnosticCmd(uacCmd);
  }

  function runDiagnosticCmd(cmd) {
    log('cmd', `PS> ${cmd}`);
    fetch('/soporte/cmd', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + localStorage.getItem('icdesk_jwt')
      },
      body: JSON.stringify({ id: currentAgentId, cmd })
    })
    .then(r => r.json())
    .then(data => log('out', data.output || data.error))
    .catch(() => log('err', 'Fallo al comunicar con la terminal remota'));
  }

  function closeSession() {
    if (activeWs) {
      activeWs.send(JSON.stringify({ type: 'stop_stream' }));
      activeWs.close();
    }
    // Enviar señal HTTP para indicarle al agente que detenga la transmisión
    if (currentAgentId) {
      fetch('/soporte/cmd', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + localStorage.getItem('icdesk_jwt')
        },
        body: JSON.stringify({ id: currentAgentId, cmd: '__RELAY_STOP__' })
      }).catch(() => {});
    }
    document.getElementById('session-view').classList.remove('active');
  }

  function log(type, text) {
    const out = document.getElementById('console-output');
    const el = document.createElement('div');
    el.className = `con-log-${type}`;
    el.textContent = text;
    out.appendChild(el);
    out.scrollTop = out.scrollHeight;
  }

  const consoleInput = document.getElementById('console-input');
  if (consoleInput) {
    consoleInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        const val = e.target.value;
        if (val) {
          runDiagnosticCmd(val);
          e.target.value = '';
        }
      }
    });
  }

  function startMonitoring() {
    fetchAgents();
    setInterval(fetchAgents, 5000);
  }



  async function logout() {
    try {
      localStorage.removeItem('icdesk_jwt');
      await fetch('/soporte/logout', { method: 'POST' });
    } catch (e) {}
    window.location.href = '/';
  }


    // --- NUEVAS HERRAMIENTAS NATIVAS ---
    let inputBlocked = false;
    
    function sendElevateCommand() {
        if (!selectedAgent) return alert("Selecciona un agente primero");
        if (confirm("Se solicitarán permisos de Administrador en la pantalla del cliente.\n\nSi el cliente acepta, el agente se reiniciará con poderes Supremos y la sesión actual se reconectará.\n\n¿Continuar?")) {
            ws.send(JSON.stringify({
                action: "command",
                agentId: selectedAgent.id,
                command: { type: "elevate" }
            }));
        }
    }

    function toggleBlockInput() {
        if (!selectedAgent) return alert("Selecciona un agente primero");
        inputBlocked = !inputBlocked;
        const btn = document.getElementById('btn-block-input');
        if (inputBlocked) {
            btn.innerHTML = '<i class="fa fa-unlock"></i><span>Desbloquear Entradas</span>';
            btn.style.color = '#ef4444';
        } else {
            btn.innerHTML = '<i class="fa fa-lock"></i><span>Bloquear Entradas</span>';
            btn.style.color = 'var(--text)';
        }
        
        ws.send(JSON.stringify({
            action: "command",
            agentId: selectedAgent.id,
            command: { type: "block_input", block: inputBlocked }
        }));
    }

    let isVideoModeFluid = false;
    function toggleVideoMode() {
        if (!activeWs || activeWs.readyState !== WebSocket.OPEN) return alert("Conéctate primero a un agente.");
        isVideoModeFluid = !isVideoModeFluid;
        const btn = document.getElementById('video-mode-btn');
        if (isVideoModeFluid) {
            btn.innerHTML = '🎞️ Modo: Fluido (H.264)';
            activeWs.send(JSON.stringify({ type: 'set_video_mode', mode: 'dxgi_h264' }));
        } else {
            btn.innerHTML = '🎥 Modo: Nítido (JPEG)';
            activeWs.send(JSON.stringify({ type: 'set_video_mode', mode: 'gdi_jpeg' }));
        }
    }

  // =====================================================================
  // CONTROL DE RATÓN (Inyectado)
  // =====================================================================
  let lastMouseTime = 0;
  canvas.addEventListener('mousemove', (e) => {
    if (!activeWs || activeWs.readyState !== WebSocket.OPEN) return;
    const now = performance.now();
    if (now - lastMouseTime < 33) return; // Throttling a ~30fps
    lastMouseTime = now;
    
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    
    activeWs.send(JSON.stringify({ type: 'mouse_move', x: x, y: y }));
  });

  canvas.addEventListener('mousedown', (e) => {
    if (!activeWs || activeWs.readyState !== WebSocket.OPEN) return;
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    
    let btn = 'left';
    if (e.button === 1) btn = 'middle';
    if (e.button === 2) btn = 'right';
    
    activeWs.send(JSON.stringify({ type: 'mouse_click', x: x, y: y, button: btn, action: 'down' }));
  });

  canvas.addEventListener('mouseup', (e) => {
    if (!activeWs || activeWs.readyState !== WebSocket.OPEN) return;
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    
    let btn = 'left';
    if (e.button === 1) btn = 'middle';
    if (e.button === 2) btn = 'right';
    
    activeWs.send(JSON.stringify({ type: 'mouse_click', x: x, y: y, button: btn, action: 'up' }));
  });

  // Evitar menú contextual en clic derecho sobre el canvas
  canvas.addEventListener('contextmenu', (e) => { e.preventDefault(); });

  // Control de scroll
  canvas.addEventListener('wheel', (e) => {
    if (!activeWs || activeWs.readyState !== WebSocket.OPEN) return;
    e.preventDefault();
    const delta = e.deltaY > 0 ? -120 : 120; // -120 = abajo, 120 = arriba
    activeWs.send(JSON.stringify({ type: 'mouse_scroll', delta: delta }));
  }, { passive: false });

  // =====================================================================
  // CONTROL DE TECLADO
  // =====================================================================
  function sendKey(e, action) {
    // Si el usuario está escribiendo en la consola, no interceptar
    if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') return;
    if (document.activeElement !== canvas) return;
    
    e.preventDefault();
    if (!activeWs || activeWs.readyState !== WebSocket.OPEN) return;
    
    activeWs.send(JSON.stringify({
      type: 'key',
      action: action,
      keyCode: e.keyCode.toString(),
      ctrl: e.ctrlKey,
      alt: e.altKey,
      shift: e.shiftKey
    }));
  }

  canvas.addEventListener('keydown', (e) => sendKey(e, 'down'));
  canvas.addEventListener('keyup', (e) => sendKey(e, 'up'));

  // --- INICIO NUEVAS FUNCIONES UI ---
  function toggleSidebar() {
    const sidebar = document.getElementById('session-sidebar');
    const icon = document.getElementById('sidebar-icon');
    if (!sidebar) return;
    sidebar.classList.toggle('collapsed');
    if (sidebar.classList.contains('collapsed')) {
      if(icon) icon.textContent = '▶ Mostrar Panel';
    } else {
      if(icon) icon.textContent = '◀ Ocultar Panel';
    }
  }

  function toggleFullScreen() {
    const sessionView = document.getElementById('session-view');
    if (!sessionView) return;
    if (!document.fullscreenElement) {
      sessionView.requestFullscreen().catch(err => {
        alert(`Error al intentar pantalla completa: ${err.message}`);
      });
    } else {
      document.exitFullscreen();
    }
  }

  function slideInSidebarFullscreen() {
    const sidebar = document.getElementById('session-sidebar');
    const arrow = document.getElementById('fullscreen-floating-arrow');
    if (!sidebar || !arrow) return;
    sidebar.classList.toggle('slide-in');
    if (sidebar.classList.contains('slide-in')) {
      arrow.style.left = '380px';
      arrow.textContent = '◀';
    } else {
      arrow.style.left = '0';
      arrow.textContent = '▶';
    }
  }

  document.addEventListener('fullscreenchange', (e) => {
    const isFullscreen = document.fullscreenElement !== null;
    const sidebar = document.getElementById('session-sidebar');
    const floatingArrow = document.getElementById('fullscreen-floating-arrow');
    const normalToggleBtn = document.getElementById('toggle-sidebar-btn');
    const fullScreenBtn = document.getElementById('fullscreen-btn');

    if (!sidebar || !floatingArrow) return;

    if (isFullscreen) {
      sidebar.classList.add('fullscreen-overlay');
      sidebar.classList.remove('slide-in');
      floatingArrow.style.display = 'block';
      floatingArrow.style.left = '0';
      floatingArrow.textContent = '▶';
      if(normalToggleBtn) normalToggleBtn.style.display = 'none';
      if(fullScreenBtn) fullScreenBtn.textContent = '⛶ Salir Pantalla Completa';
    } else {
      sidebar.classList.remove('fullscreen-overlay');
      sidebar.classList.remove('slide-in');
      floatingArrow.style.display = 'none';
      if(normalToggleBtn) normalToggleBtn.style.display = 'block';
      if(fullScreenBtn) fullScreenBtn.textContent = '⛶ Pantalla Completa';
    }
  });


  window.setAlias = function(id, currentAlias) {
    const modal = document.getElementById('alias-modal');
    const input = document.getElementById('alias-input');
    if (modal && input) {
        window.currentAliasId = id;
        input.value = currentAlias;
        modal.classList.add('is-visible');
        input.focus();
    }
  };

  window.closeAliasModal = function() {
    const modal = document.getElementById('alias-modal');
    if (modal) modal.classList.remove('is-visible');
  };

  window.saveAlias = function() {
    const input = document.getElementById('alias-input');
    if (input && window.currentAliasId) {
        const newAlias = input.value.trim();
        if (newAlias) {
            localStorage.setItem("alias_" + window.currentAliasId, newAlias);
            if (typeof fetchAgents === "function") fetchAgents();
        }
        window.closeAliasModal();
    }
  };

  // --- FIN NUEVAS FUNCIONES UI ---

</script>

  </div>
