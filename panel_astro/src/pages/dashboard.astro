  function applyNetConfig() {
    const adapter = (document.getElementById('net-adapter-sel') || {}).value || 'Ethernet';
    if (_netMode === 'dhcp') {
      runPS(`Set-NetIPInterface -InterfaceAlias '${adapter}' -Dhcp Enabled; Set-DnsClientServerAddress -InterfaceAlias '${adapter}' -ResetServerAddresses; ipconfig /renew '${adapter}'; Write-Output '✅ DHCP activado en ${adapter}'`);
    } else {
      const ip   = (document.getElementById('net-ip')   || {}).value;
      const mask = (document.getElementById('net-mask') || {}).value;
      const gw   = (document.getElementById('net-gw')  || {}).value;
      const dns1 = (document.getElementById('net-dns1')|| {}).value || '8.8.8.8';
      const dns2 = (document.getElementById('net-dns2')|| {}).value || '8.8.4.4';
      const prefix = mask === '255.255.255.0' ? 24 : mask === '255.255.0.0' ? 16 : 24;
      runPS(`Remove-NetIPAddress -InterfaceAlias '${adapter}' -Confirm:$false -EA SilentlyContinue; New-NetIPAddress -InterfaceAlias '${adapter}' -IPAddress '${ip}' -PrefixLength ${prefix} -DefaultGateway '${gw}'; Set-DnsClientServerAddress -InterfaceAlias '${adapter}' -ServerAddresses ('${dns1}','${dns2}'); Write-Output '✅ IP fija aplicada en ${adapter}: ${ip}'`);
    }
    document.getElementById('net-modal').style.display = 'none';
  }

