    drives:       `Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Usado(GB)';E={[math]::Round(($_.Used/1GB),2)}}, @{N='Libre(GB)';E={[math]::Round(($_.Free/1GB),2)}}, @{N='Total(GB)';E={[math]::Round((($_.Used+$_.Free)/1GB),2)}} | Format-Table`,
