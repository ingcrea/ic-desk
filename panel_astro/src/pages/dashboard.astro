    ramclean:     `$before = (Get-WmiObject Win32_OperatingSystem).FreePhysicalMemory; [System.GC]::Collect(); $after = (Get-WmiObject Win32_OperatingSystem).FreePhysicalMemory; Write-Output ("RAM liberada aprox: " + [math]::Round(($after-$before)/1024,1) + " MB")`,
