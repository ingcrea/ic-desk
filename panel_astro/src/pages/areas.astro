---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Layout title="Areas | IC-Desk Enterprise">
  <div class="c-layout">
    <div id="space-background" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none;" transition:persist>
      <canvas id="starfield"></canvas>
    </div>
    
    <Sidebar />
    
    <main class="c-main" style="position: relative; z-index: 1;"><header class="c-main__header"><div><h1 class="c-page-header__title" style="margin: 0;">Áreas de Atención</h1><p class="c-page-header__desc" style="margin: 0;">Clasificación de equipos por departamentos o zonas físicas.</p></div><button class="c-btn c-btn--primary" onclick="openAreaModal()"><span>+ Nueva Área</span></button></header><div class="c-main__content"><div class="c-table-container"><table class="c-table"><thead><tr><th>ID Área</th><th>Nombre del Área</th><th>Descripción / Detalles</th><th style="text-align: right;">Administración</th></tr></thead><tbody id="areas-table-body"><tr><td colspan="4" style="text-align:center; color:var(--c-text-muted);">Cargando áreas...</td></tr></tbody></table></div></div></main>
  </div>

</Layout>
