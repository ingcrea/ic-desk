---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Layout title="Auditoria | IC-Desk Enterprise">
  <div class="c-layout">
    <div id="space-background" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none;" transition:persist>
      <canvas id="starfield"></canvas>
    </div>
    
    <Sidebar />
    
    <main class="c-main" style="position: relative; z-index: 1;"><header class="c-main__header"><div><h1 class="c-page-header__title" style="margin: 0;">Auditoría y Logs</h1><p class="c-page-header__desc" style="margin: 0;">Registro inmutable de actividad de los técnicos y agentes.</p></div><button class="c-btn c-btn--outline" onclick="fetchLogs()"><span>🔄 Refrescar</span></button></header><div class="c-main__content"><div class="c-table-container"><table class="c-table"><thead><tr><th>Fecha/Hora</th><th>Usuario</th><th>Acción</th><th>Detalle</th><th>IP</th></tr></thead><tbody id="logs-table-body"><tr><td colspan="5" style="text-align:center; color:var(--c-text-muted);">Sincronizando logs...</td></tr></tbody></table></div></div></main>
  </div>

</Layout>
