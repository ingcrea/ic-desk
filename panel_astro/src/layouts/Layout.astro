---
import { ClientRouter } from 'astro:transitions';
const { title = "IC-Desk — Soporte Remoto Enterprise" } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <ClientRouter />
  <!-- Metadatos de SEO y Compatibilidad Móvil -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta name="theme-color" content="#060913" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="IC-Desk" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  
  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:site_name" content="Ingeniería Creativa IC-Desk" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="IC-Desk — Soporte Remoto Enterprise por IngCrea" />
  <meta property="og:description" content="Plataforma ultra fluida de soporte técnico y monitoreo remoto a 60 FPS." />
  <meta property="og:url" content="https://desk.ingcrea.com" />
  <meta property="og:image" content="/soporte/download/logo?v=2.0.1" />
  <meta property="og:locale" content="es_MX" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="IC-Desk — Soporte Remoto Enterprise" />
  <meta name="twitter:description" content="Centro de Operaciones y Soporte Remoto por Ingeniería Creativa." />
  <meta name="twitter:image" content="/soporte/download/logo?v=2.0.1" />

  <link rel="icon" type="image/x-icon" href="/soporte/download/favicon?v=2.0.1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/tailwind.css?v=3.0" />
  <title>{title}</title>
  <slot name="head" />
</head>
<body>
  <div id="space-background" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none;" transition:persist>
    <canvas id="starfield"></canvas>
  </div>
  <slot />
  <!-- TOAST CONTAINER -->
  <div id="ic-toast-container" class="c-toast-container"></div>
  
  <script is:inline>
    window.playElegantNotification = function() {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if(!window.audioCtx) window.audioCtx = new AudioContext();
            const ctx = window.audioCtx;
            if (ctx.state === 'suspended') ctx.resume();
            
            const osc = ctx.createOscillator();
            const gainNode = ctx.createGain();
            
            // Acorde de cristal/campana elegante
            osc.type = 'sine';
            osc.frequency.setValueAtTime(1046.50, ctx.currentTime); // C6
            osc.frequency.setTargetAtTime(1318.51, ctx.currentTime + 0.05, 0.02); // E6
            
            gainNode.gain.setValueAtTime(0, ctx.currentTime);
            gainNode.gain.linearRampToValueAtTime(0.2, ctx.currentTime + 0.02);
            gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);
            
            osc.connect(gainNode);
            gainNode.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 1.2);
        } catch(e) {}
    }

    window.showToast = function(msg, type = 'info') {
        let container = document.getElementById('ic-toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `ic-toast ic-toast-${type}`;
        
        let icon = '💡';
        if(type === 'success') icon = '✅';
        if(type === 'error') icon = '🚨';
        if(type === 'warning') icon = '⚠️';
        
        toast.innerHTML = `<span class="ic-toast-icon">${icon}</span><span class="ic-toast-msg">${msg}</span>`;
        container.appendChild(toast);
        
        window.playElegantNotification();
        
        // Entrada
        setTimeout(() => {
            toast.style.transform = 'translateX(0) scale(1)';
            toast.style.opacity = '1';
        }, 10);
        
        // Salida
        setTimeout(() => {
            toast.style.transform = 'translateX(100px) scale(0.9)';
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    };

    // Sobrescribir alert original para atrapar todos los alerts que quedaron sin cambiar
    window.alert = function(msg) {
        window.showToast(msg, 'info');
    };
  </script>
  <script>
    // Fondo Espacial Persistente
    const canvas = document.getElementById("starfield");
    if (canvas) {
      const ctx = canvas.getContext("2d");
      
      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener("resize", resize);

      const numStaticStars = 160;
      const staticStars = [];
      const starColors = ["#ffffff", "#f0f4f8", "#e2e8f0", "#63b3ed", "#90cdf4", "#b794f4", "#fbd38d"];

      for (let i = 0; i < numStaticStars; i++) {
        staticStars.push({
          x: Math.random(),
          y: Math.random(),
          size: Math.random() * 1.6 + 0.5,
          color: starColors[Math.floor(Math.random() * starColors.length)],
          baseAlpha: Math.random() * 0.7 + 0.3,
          twinkleSpeed: Math.random() * 0.02 + 0.005,
          alphaOffset: Math.random() * Math.PI * 2
        });
      }

      const numTravelStars = 40;
      const travelStars = [];
      for (let i = 0; i < numTravelStars; i++) {
        travelStars.push({
          x: (Math.random() - 0.5),
          y: (Math.random() - 0.5),
          z: Math.random() * 1000 + 1,
          size: Math.random() * 1.5 + 0.8,
          color: "rgba(255, 255, 255, 0.95)"
        });
      }

      const comets = [];
      function spawnComet() {
        if (comets.length >= 6) return;
        const angle = (Math.random() * 15 + 25) * (Math.PI / 180);
        const speed = Math.random() * 8 + 6;
        comets.push({
          x: Math.random() * (canvas.width * 0.7),
          y: -50,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          length: Math.random() * 80 + 40,
          width: Math.random() * 2 + 1,
          alpha: Math.random() * 0.5 + 0.5,
          decay: Math.random() * 0.015 + 0.005
        });
      }
      setInterval(spawnComet, 800);

      function animate(time) {
        ctx.fillStyle = "rgba(6, 9, 19, 1)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const width = canvas.width;
        const height = canvas.height;
        const centerX = width / 2;
        const centerY = height / 2;

        for (let i = 0; i < staticStars.length; i++) {
          const s = staticStars[i];
          const currentAlpha = s.baseAlpha + Math.sin(time * s.twinkleSpeed + s.alphaOffset) * 0.3;
          ctx.fillStyle = s.color;
          ctx.globalAlpha = Math.max(0.1, currentAlpha);
          ctx.beginPath();
          ctx.arc(s.x * width, s.y * height, s.size, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1.0;

        for (let i = 0; i < travelStars.length; i++) {
          const s = travelStars[i];
          s.z -= 2;
          if (s.z <= 0) {
            s.x = (Math.random() - 0.5);
            s.y = (Math.random() - 0.5);
            s.z = 1000;
          }
          const scale = 800 / s.z;
          const px = centerX + s.x * scale * width;
          const py = centerY + s.y * scale * height;

          if (px >= 0 && px <= width && py >= 0 && py <= height) {
            ctx.fillStyle = s.color;
            ctx.beginPath();
            ctx.arc(px, py, s.size * scale, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        for (let i = comets.length - 1; i >= 0; i--) {
          const c = comets[i];
          c.x += c.vx;
          c.y += c.vy;
          c.alpha -= c.decay;

          if (c.alpha <= 0 || c.x > width + 100 || c.y > height + 100) {
            comets.splice(i, 1);
            continue;
          }

          const headX = c.x;
          const headY = c.y;
          const tailX = c.x - (c.vx / Math.hypot(c.vx, c.vy)) * c.length;
          const tailY = c.y - (c.vy / Math.hypot(c.vx, c.vy)) * c.length;

          const grad = ctx.createLinearGradient(headX, headY, tailX, tailY);
          grad.addColorStop(0, "rgba(255, 255, 255, " + c.alpha + ")");
          grad.addColorStop(0.2, "rgba(147, 197, 253, " + (c.alpha * 0.7) + ")");
          grad.addColorStop(1, "rgba(147, 197, 253, 0)");

          ctx.beginPath();
          ctx.moveTo(headX, headY);
          ctx.lineTo(tailX, tailY);
          ctx.strokeStyle = grad;
          ctx.lineWidth = c.width;
          ctx.lineCap = "round";
          ctx.stroke();
        }

        requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
    }
  </script>
</body>
</html>

<style lang="scss" is:global>
  @import "../styles/global.scss";
</style>
